[Unit]
Description=Bot Manager OpenClaw stack
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bot-manager
ExecStart=/usr/bin/docker compose --env-file .env.local up -d
ExecStop=/usr/bin/docker compose --env-file .env.local down

[Install]
WantedBy=multi-user.target
