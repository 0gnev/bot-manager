PROJECT_NAME=bot-manager
TZ=Asia/Bishkek

# ── AI / LLM providers ────────────────────────────────────────────────────────
#
# The bridge talks to models directly — no gateway in between.
# Run `botmgr setup` for a guided configuration, or fill these in by hand.
#
# LLM_PROVIDER — primary provider:
#   openai      — OpenAI API (needs OPENAI_API_KEY)
#   openrouter  — OpenRouter, many hosted models (needs OPENROUTER_API_KEY)
#   anthropic   — Anthropic API (needs ANTHROPIC_API_KEY)
#   ollama      — local Ollama server (no key needed)
#   lmstudio    — local LM Studio server (no key needed)
#   custom      — any OpenAI-compatible endpoint (set LLM_BASE_URL)
#
# LLM_MODEL — model name for the primary provider. Empty = provider default.
#   Examples: gpt-5-mini | claude-haiku-4-5 | llama3.1:8b
#
# LLM_FALLBACKS — optional failover chain, comma-separated "provider:model".
#   Example: LLM_FALLBACKS=ollama:llama3.1:8b
#   (cloud primary with a local fallback — or the other way around)
#
LLM_PROVIDER=openai
LLM_MODEL=
LLM_FALLBACKS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# For LLM_PROVIDER=custom (any OpenAI-compatible server):
LLM_BASE_URL=
LLM_API_KEY=
# Local model servers. host.docker.internal reaches the host from the container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# ── Telegram ──────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN_STUDENT — student-facing bot.
#   Polled by Bridge. Any Telegram user can message it.
#   Used for: /start deeplink, student Q&A, AI replies, escalation confirmations.
#
# TELEGRAM_BOT_TOKEN_OWNER — tutor/owner bot (restricted).
#   Polled by Bridge. Only whitelisted users (TUTOR_CHAT_ID) can interact.
#   Used for: escalation notices, tutor reply-to routing, approval actions.
#
TELEGRAM_BOT_TOKEN_STUDENT=
TELEGRAM_BOT_TOKEN_OWNER=
TELEGRAM_MODE=polling
TUTOR_CHAT_ID=               # Tutor's Telegram user/chat ID (whitelist for owner bot)

# ── Planerka ──────────────────────────────────────────────────────────────────
PLANERKA_BASE_URL=
PLANERKA_API_KEY=            # x-auth token for calling Planerka REST API
PLANERKA_WEBHOOK_SECRET=     # Bearer secret Planerka sends on incoming webhooks

# ── Tutor API ─────────────────────────────────────────────────────────────────
TUTOR_API_TOKEN=             # Separate token for tutor REST API (/api/tutor/*)

# ── Knowledge (Obsidian) ──────────────────────────────────────────────────────
# Absolute path to your Obsidian vault (or any folder of markdown notes).
# It is mounted into the container at /workspace/data/knowledge.
# Leave empty to use the built-in ./data/knowledge folder.
OBSIDIAN_VAULT_PATH=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bridge:bridge@postgres:5432/bridge

# ── Runtime storage ───────────────────────────────────────────────────────────
AUDIT_PATH=/workspace/data/audit
LOG_PATH=/workspace/data/logs
LOG_LEVEL=INFO
