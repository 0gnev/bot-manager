PROJECT_NAME=bot-manager
TZ=Asia/Bishkek

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN_STUDENT — student-facing bot.
#   Polled by Bridge. Any Telegram user can message it.
#   Used for: /start deeplink, student Q&A, AI replies, escalation confirmations.
#
# TELEGRAM_BOT_TOKEN_OWNER — tutor/owner bot (restricted).
#   Polled by OpenClaw. Only whitelisted users (TUTOR_CHAT_ID) can interact.
#   Used for: escalation notices, tutor reply-to routing, OpenClaw admin channel.
#
TELEGRAM_BOT_TOKEN_STUDENT=
TELEGRAM_BOT_TOKEN_OWNER=
TELEGRAM_MODE=polling
TUTOR_CHAT_ID=               # Tutor's Telegram user/chat ID (whitelist for owner bot)

# ── Planerka ──────────────────────────────────────────────────────────────────
PLANERKA_BASE_URL=
PLANERKA_API_KEY=            # x-auth token for calling Planerka REST API
PLANERKA_WEBHOOK_SECRET=     # Bearer secret Planerka sends on incoming webhooks

# ── OpenClaw ──────────────────────────────────────────────────────────────────
GATEWAY_AUTH_TOKEN=          # Shared gateway auth token (OpenClaw HTTP API)
TUTOR_API_TOKEN=             # Separate token for tutor REST API (/api/tutor/*)
OPENCLAW_CONFIG_PATH=/workspace/config/openclaw.json

# ── Knowledge ─────────────────────────────────────────────────────────────────
OBSIDIAN_SOURCE_PATH=
KNOWLEDGE_MIRROR_PATH=/workspace/data/knowledge

# ── Runtime storage ───────────────────────────────────────────────────────────
AUDIT_PATH=/workspace/data/audit
LOG_PATH=/workspace/data/logs
LOG_LEVEL=INFO
