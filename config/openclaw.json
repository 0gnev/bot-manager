{
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN_MANAGER}",
      "dmPolicy": "allowlist",
      "allowFrom": ["tg:${TUTOR_CHAT_ID}"],
      "streaming": "block"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5-mini"
      }
    }
  },
  "gateway": {
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_AUTH_TOKEN}"
    }
  }
}
