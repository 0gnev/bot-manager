{
  "project": "bot-manager",
  "telegram": {
    "mode": "polling",
    "bots": {
      "student": {
        "env": "TELEGRAM_BOT_TOKEN_STUDENT",
        "access": "open",
        "purpose": "Student-facing bot, polled by Bridge"
      },
      "owner": {
        "env": "TELEGRAM_BOT_TOKEN_OWNER",
        "access": "whitelist",
        "purpose": "Tutor/owner bot, polled by Bridge for operator actions"
      }
    }
  },
  "roles": {
    "student": "student-assistant",
    "owner": "tutor-admin"
  },
  "knowledge": {
    "provider": "obsidian",
    "path": "/workspace/data/knowledge"
  }
}
